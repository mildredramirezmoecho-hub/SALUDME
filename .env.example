# ==========================================================
# SALUDME — Variables de entorno (PLANTILLA)
# Copia este fichero a .env y rellena tus valores reales:
#   cp .env.example .env
# El fichero .env está en .gitignore: NUNCA se sube a Git.
# ==========================================================

# Conexión a MySQL (esquema SaludMe)
DATABASE_URL=mysql+mysqlconnector://USUARIO:CONTRASENA@localhost:3307/SaludMe

# Clave secreta de Flask (sesiones). Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Servidor SMTP (Brevo)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# Remitente por defecto de los correos
MAIL_DEFAULT_SENDER_EMAIL=
